# --- Atlassian (Jira & Confluence) ---
ATLASSIAN_URL=https://<your_project>.atlassian.net
ATLASSIAN_EMAIL=<your_email>
ATLASSIAN_API_TOKEN=<your_atlasian_email>

# --- Testomat ---
TESTOMATIO_PROJECT_TOKEN=<your_testomat_main_token>
TESTOMATIO_PROJECT_ID=<id>
TESTOMATIO_BASE_URL="https://app.testomat.io"

# --- Limit for req-rewiwer major findings ---
QA_GATE1_MAJOR_LIMIT=8

# --- Gate retry limit (retries per project: jira=Gate 2a, test=Gate 2b); default 5, max 5 ---
QA_RETRY_LIMIT=5

# --- Publish resilience / retry window (Jira & Testomat MCP) ---
# Total time budget for retrying transient read/search/list errors (seconds). Default 900.
QA_PUBLISH_RETRY_WINDOW_SECONDS=900
# Max attempts per read operation within the window. Default 12.
QA_PUBLISH_MAX_ATTEMPTS=12
# Upper bound of the backoff pause between retries (seconds). Default 60.
QA_PUBLISH_BACKOFF_MAX=60

# --- Interactive upload-failure decision point ---
# true -> on exhausted retry window ask the user: retry_upload | defer_and_stop | abort
# false (default) -> deterministic blocked_transient + retry_after (no question; CI-safe)
QA_INTERACTIVE=false

# --- Working directory (repo root with trailing slash); used by the MCP patch instead of a hardcoded absolute path ---
QA_WORK_DIR="/path/to/AI_education/"
