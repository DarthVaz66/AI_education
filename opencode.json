{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jira-confluence": {
      "type": "local",
      "command": ["node", "{env:QA_WORK_DIR}.opencode/mcp/mcp-jira-confluence/dist/index.js"],
      "environment": {
        "ATLASSIAN_SITE": "{env:ATLASSIAN_SITE}",
        "ATLASSIAN_EMAIL": "{env:ATLASSIAN_EMAIL}",
        "ATLASSIAN_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      },
      "enabled": true
    },
    "testomat": {
      "type": "local",
      "command": [
        "npx", "-y", "@testomatio/mcp@latest",
        "--token", "{env:TESTOMATIO_PROJECT_TOKEN}",
        "--project", "{env:TESTOMATIO_PROJECT_ID}"
      ],
      "environment": {
        "TESTOMATIO_BASE_URL": "https://app.testomat.io"
      },
      "enabled": true
    }
  },
  "permission": {
    "mcp": {
      "jira-confluence": "allow",
      "qase": "allow",
      "artifact-store": "allow"
    }
  },
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloud.ru Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash (cloud.ru)"
        }
      }
    }
  }
}
