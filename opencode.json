{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "jira-confluence": {
      "type": "local",
      "command": ["npx", "-y", "mcp-jira-confluence"],
      "environment": {
        "ATLASSIAN_SITE": "{env:ATLASSIAN_SITE}",
        "ATLASSIAN_EMAIL": "{env:ATLASSIAN_EMAIL}",
        "ATLASSIAN_API_TOKEN": "{env:ATLASSIAN_API_TOKEN}"
      },
      "enabled": true
    },
    "qase": {
      "type": "local",
      "command": ["npx", "-y", "@qase/mcp-server"],
      "environment": {
        "QASE_API_TOKEN": "{env:QASE_API_TOKEN}"
      },
      "enabled": true
    },
    "artifact-store": {
      "type": "local",
      "command": ["npx", "-y", "@opendock/artifact-server-mcp"],
      "environment": {
        "ARTIFACT_SERVER_URL": "{env:ARTIFACT_SERVER_URL}"
      },
      "enabled": false
    }
  },
  "permission": {
    "mcp": {
      "jira-confluence": "allow",
      "qase": "allow",
      "artifact-store": "allow"
    }
  },
  "provider": {
    "cloudru": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cloud.ru Foundation Models",
      "options": {
        "baseURL": "https://foundation-models.api.cloud.ru/v1",
        "apiKey": "{env:CLOUDRU_API_KEY}"
      },
      "models": {
        "deepseek-ai/DeepSeek-V4.1-Flash": {
          "name": "DeepSeek V4.1 Flash (cloud.ru)"
        }
      }
    }
  }
}
